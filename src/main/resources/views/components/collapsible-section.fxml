<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" styleClass="section">
    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="section-row" onMouseClicked="#onToggle">
        <StackPane styleClass="section-chevron">
            <Region fx:id="chevron" styleClass="icon, icon-muted" />
        </StackPane>
        <Label fx:id="titleLabel" styleClass="section-title" />
        <Label fx:id="countLabel" styleClass="section-count" />
        <Label fx:id="previewLabel" styleClass="section-preview" textOverrun="ELLIPSIS"
               minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
        <HBox fx:id="headerContent" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS"
              visible="false" managed="false" />
    </HBox>
    <VBox fx:id="body" styleClass="section-body" VBox.vgrow="ALWAYS" />
</VBox>