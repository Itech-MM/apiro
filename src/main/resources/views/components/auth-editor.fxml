<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import io.github.itech_mm.apiro.ui.editor.SecretVariableField?>
<?import io.github.itech_mm.apiro.ui.editor.VariableField?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" spacing="10" maxWidth="520">
    <HBox alignment="CENTER_LEFT" spacing="8">
        <Label text="Type" styleClass="muted" minWidth="-Infinity" prefWidth="90" />
        <ComboBox fx:id="typeCombo" prefWidth="200" />
    </HBox>
    <VBox fx:id="basicBox" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Username" styleClass="muted" minWidth="-Infinity" prefWidth="90" />
            <VariableField fx:id="usernameField" styleClass="kv-field" minWidth="0" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Password" styleClass="muted" minWidth="-Infinity" prefWidth="90" />
            <SecretVariableField fx:id="passwordField" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>
    <VBox fx:id="bearerBox" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Token" styleClass="muted" minWidth="-Infinity" prefWidth="90" />
            <SecretVariableField fx:id="tokenField" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>
    <VBox fx:id="apiKeyBox" spacing="8">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Key name" styleClass="muted" minWidth="-Infinity" prefWidth="90" />
            <VariableField fx:id="keyNameField" styleClass="kv-field" minWidth="0" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <Label text="Key value" styleClass="muted" minWidth="-Infinity" prefWidth="90" />
            <SecretVariableField fx:id="keyValueField" HBox.hgrow="ALWAYS" />
        </HBox>
    </VBox>
</VBox>