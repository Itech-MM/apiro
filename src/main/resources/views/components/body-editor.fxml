<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.itech_framework.code_editor.CodeEditor?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="root" minHeight="0">
    <HBox fx:id="header" alignment="CENTER_LEFT" spacing="8">
        <HBox fx:id="chipBox" alignment="CENTER_LEFT" spacing="2" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="beautifyButton" text="Beautify" styleClass="link-button" onAction="#onBeautify" />
                <Label fx:id="contentTypeLabel" styleClass="muted, content-type-label"
               minWidth="250" prefWidth="250" maxWidth="250" alignment="CENTER_RIGHT"
               textOverrun="ELLIPSIS" />
    </HBox>
    <StackPane fx:id="contentPane" minHeight="120" alignment="TOP_LEFT" VBox.vgrow="ALWAYS">
        <CodeEditor fx:id="editor" />
        <Label fx:id="placeholderLabel" styleClass="muted">
            <padding>
                <Insets top="12" left="16" />
            </padding>
        </Label>
    </StackPane>
</VBox>